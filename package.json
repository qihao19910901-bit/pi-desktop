{
  "name": "pi-desktop",
  "version": "1.1.5",
  "description": "Pi Desktop - pi-web 的 Electron 桌面应用封装",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev.js",
    "test": "node --test",
    "build:dir": "node electron/run-build.js --dir",
    "build": "node electron/run-build.js",
    "verify:package": "node scripts/verify-package.js",
    "smoke:package": "node scripts/smoke-packaged-app.js",
    "dist": "npm run build",
    "start:piweb": "node_modules/@agegr/pi-web/bin/pi-web.js --hostname 127.0.0.1 --no-open"
  },
  "keywords": [
    "pi",
    "electron",
    "ai",
    "coding-agent"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agegr/pi-web": "0.8.5",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "electron-updater": "6.8.9"
  },
  "overrides": {
    "@agegr/pi-web": {
      "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent"
    }
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "yaml": "2.9.0"
  }
}
