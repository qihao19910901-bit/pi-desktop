{
  "name": "pi-desktop",
  "version": "1.1.6",
  "description": "Pi Desktop - pi-web 的 Electron 桌面应用封装",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev.js",
    "build": "node electron/run-build.js",
    "dist": "npm run build",
    "start:piweb": "node_modules/@agegr/pi-web/bin/pi-web.js --hostname 0.0.0.0"
  },
  "keywords": [
    "pi",
    "electron",
    "ai",
    "coding-agent"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@agegr/pi-web": "^0.8.6",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "@agegr/pi-web": {
      "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
